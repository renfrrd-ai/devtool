---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ToolCard from '../components/ToolCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sortedTools } from '../data/tools';
import { SITE } from '../data/site';

const tools = sortedTools();

const principles = [
  {
    number: '01',
    title: 'One front door',
    body: 'Every tool keeps its own domain and its own identity. This page exists so none of them has to be discovered by accident.',
  },
  {
    number: '02',
    title: 'Honest status',
    body: 'A badge on each entry says exactly what you will find: something you can use today, something half-built, or an idea with a domain attached.',
  },
  {
    number: '03',
    title: 'Built to stay small',
    body: 'Static HTML, no tracking, no framework doing work it does not need to. Adding the next tool takes one entry in one file.',
  },
];
---

<Base title={SITE.title} description={SITE.description}>
  <SiteHeader />

  <main>
    <Hero />

    <section id="tools" class="section tools">
      <div class="container container--reading">
        <p class="eyebrow">The directory</p>
        <h2 class="h2 tools__title">Everything, in one place.</h2>
        <p class="lead tools__lead">
          Each entry links straight out to the tool&rsquo;s own site. Live things come first.
        </p>

        <ul class="tools__list">
          {tools.map((tool) => <ToolCard tool={tool} />)}
        </ul>
      </div>
    </section>

    <section id="approach" class="section approach">
      <div class="container container--reading">
        <p class="eyebrow">Approach</p>
        <h2 class="h2 approach__title">Why this page exists.</h2>

        <div class="approach__grid">
          {
            principles.map((item) => (
              <div class="principle">
                <span class="principle__number">{item.number}</span>
                <span class="principle__rule" aria-hidden="true" />
                <h3 class="principle__title">{item.title}</h3>
                <p class="principle__body">{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .tools__title,
  .approach__title {
    margin-top: 1.25rem;
  }

  .tools__lead {
    margin-top: 1.5rem;
  }

  .tools__list {
    margin-top: 3.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .approach {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .approach__grid {
    margin-top: 4rem;
    display: grid;
    gap: 3rem;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .principle__number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .principle__rule {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--border-strong);
  }

  .principle__title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .principle__body {
    color: var(--text-muted);
    line-height: 1.65;
  }

  @media (min-width: 640px) {
    .approach__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }

    .principle__number {
      font-size: 3rem;
    }
  }
</style>
