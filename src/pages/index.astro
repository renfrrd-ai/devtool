---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import CategoryCard from '../components/CategoryCard.astro';
import PopularTools from '../components/PopularTools.astro';
import ToolRow from '../components/ToolRow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';
import { populatedCategories, sortedMadeHere, stats, categoryHref } from '../lib/directory';

const cats = populatedCategories();
const mine = sortedMadeHere();

/*
 * The home page lists categories, not tools. Fifty rows here would bury the
 * thing that makes the site usable — the shelves — under the thing that makes
 * it long.
 */
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/#collection`,
    name: SITE.title,
    description: SITE.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: cats.map((category) => ({
      '@type': 'Thing',
      name: category.name,
      url: `${SITE.url}${categoryHref(category.id)}`,
    })),
  },
];
---

<Base title={SITE.title} description={SITE.description} schema={schema}>
  <SiteHeader />

  <main id="main">
    <Hero />

    <section id="categories" class="section">
      <div class="container container--wide">
        <p class="eyebrow">Browse</p>
        <h2 class="h2 section__title">Nine shelves, {stats.tools} tools.</h2>
        <p class="lead section__lead">
          Each shelf is a page with the full list, what every tool runs on, and what it
          costs. Nothing here is ranked — a directory that pretends to rank is worse than
          one that admits it does not.
        </p>

        <div class="cats">
          {cats.map((category) => <CategoryCard {...category} />)}
        </div>
      </div>
    </section>

    {/* Renders nothing until the analytics snapshot has real data in it. */}
    <PopularTools />

    <section id="built-here" class="section built">
      <div class="container container--reading">
        <p class="eyebrow">Built here</p>
        <h2 class="h2 section__title">Tools from this side of the site.</h2>
        <p class="lead section__lead">
          The reason devtool.fyi exists. These are made and maintained by
          {SITE.author.name}, and they sit in the categories above alongside everything
          else — no special treatment beyond this section.
        </p>

        <ul class="built__list">
          {mine.map((tool) => <ToolRow tool={tool} />)}
        </ul>
      </div>
    </section>

    <section id="approach" class="section approach">
      <div class="container container--reading">
        <p class="eyebrow">Approach</p>
        <h2 class="h2 section__title">How this list works.</h2>

        <div class="approach__grid">
          <div class="principle">
            <span class="principle__number">01</span>
            <span class="principle__rule" aria-hidden="true"></span>
            <h3 class="principle__title">Opinions, not listings</h3>
            <p class="principle__body">
              Every entry says what the tool is actually for and where the catch is. A
              directory that only repeats marketing copy saves nobody any time.
            </p>
          </div>

          <div class="principle">
            <span class="principle__number">02</span>
            <span class="principle__rule" aria-hidden="true"></span>
            <h3 class="principle__title">Small enough to trust</h3>
            <p class="principle__body">
              A curated set, not everything that exists. Shelves get added when there are
              enough good tools to fill one, not to pad the count.
            </p>
          </div>

          <div class="principle">
            <span class="principle__number">03</span>
            <span class="principle__rule" aria-hidden="true"></span>
            <h3 class="principle__title">Built to stay small</h3>
            <p class="principle__body">
              Static HTML, no tracking, no framework doing work it does not need to.
              Adding the next tool takes one entry in one file.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/*
      Last section on the page, and deliberately so: the ask comes after the
      thing being asked about. A reader who has not scrolled this far has no
      reason to add anything yet. The detail lives on /contribute/ — this is
      three lines and a door.
    */}
    <section id="contribute" class="section contribute">
      <div class="container container--reading">
        <p class="eyebrow">Contribute</p>
        <h2 class="h2 section__title">Missing something?</h2>
        <p class="lead section__lead">
          The list grows when somebody says what is not on it. Suggesting a tool takes two
          minutes and readers vote on it; adding one yourself is a pull request touching
          one file; saying an entry has gone stale needs no account at all.
        </p>

        <ul class="ways">
          <li class="way">
            <span class="way__label">Suggest a tool</span>
            <span class="way__cost">Two minutes, and other readers vote on it</span>
          </li>
          <li class="way">
            <span class="way__label">Add one yourself</span>
            <span class="way__cost">One entry in one file, and it is on the shelf</span>
          </li>
          <li class="way">
            <span class="way__label">Report an entry</span>
            <span class="way__cost">Prices change and links die — nothing notices on its own</span>
          </li>
        </ul>

        <a class="btn btn--primary contribute__cta" href="/contribute/">
          How contributing works
          <svg
            class="arrow"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .section__title {
    margin-top: 1.25rem;
  }

  .section__lead {
    margin-top: 1.5rem;
  }

  .cats {
    margin-top: 3.5rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .built {
    border-top: 1px solid var(--border);
  }

  .built__list {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .approach {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .approach__grid {
    margin-top: 4rem;
    display: grid;
    gap: 3rem;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .principle__number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .principle__rule {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--border-strong);
  }

  .principle__title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .principle__body {
    color: var(--text-muted);
    line-height: 1.65;
  }

  .contribute {
    border-top: 1px solid var(--border);
  }

  .ways {
    margin-top: 2.75rem;
    border-top: 1px solid var(--border);
  }

  .way {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--border);
  }

  .way__label {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .way__cost {
    font-size: var(--text-ui);
    color: var(--text-muted);
  }

  .contribute__cta {
    margin-top: 2.5rem;
  }

  @media (min-width: 640px) {
    .approach__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .principle__number {
      font-size: 3rem;
    }

    .way {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }
</style>
