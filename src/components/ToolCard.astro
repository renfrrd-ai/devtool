---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Tool } from '../data/tools';
import StatusBadge from './StatusBadge.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const monogram = tool.name.charAt(0).toUpperCase();

/*
 * An explicit `logo` wins; otherwise we pick up whatever `npm run logos`
 * vendored for this tool. Resolved at build time, so a missing icon costs the
 * page nothing and quietly falls back to a monogram.
 */
function resolveLogo(): string | undefined {
  if (tool.logo) return tool.logo;
  for (const ext of ['svg', 'png']) {
    // Resolved against the project root — import.meta.url points into the Vite
    // build output here, not at this source file.
    if (existsSync(join(process.cwd(), 'public', 'logos', `${tool.id}.${ext}`))) {
      return `/logos/${tool.id}.${ext}`;
    }
  }
  return undefined;
}

const logo = resolveLogo();
---

<li class="row">
  <a class="row__link" href={tool.url} rel="noopener" id={tool.id}>
    <span class:list={['row__mark', logo && 'row__mark--logo']} aria-hidden="true">
      {
        logo ? (
          <img class="row__logo" src={logo} alt="" width="48" height="48" loading="lazy" />
        ) : (
          <span class="row__monogram">{monogram}</span>
        )
      }
    </span>

    <span class="row__body">
      <span class="row__head">
        <span class="row__name">{tool.name}</span>
        <StatusBadge status={tool.status} />
      </span>
      <span class="row__tagline">{tool.tagline}</span>
    </span>

    <span class="row__meta">
      <span class="row__domain">{tool.domain}</span>
      <svg
        class="row__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M7 7h10v10"></path>
      </svg>
    </span>
  </a>
</li>

<style>
  .row + .row {
    border-top: 1px solid var(--border);
  }

  .row__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--radius-sm);
    transition: background-color 150ms ease;
  }

  .row__link:hover {
    background: var(--bg-subtle);
  }

  /* The tool's own favicon, or a monogram tile when it has no mark. */
  .row__mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
    overflow: hidden;
  }

  /*
   * Real marks arrive with their own ground and their own corner radius, so the
   * chrome comes off — a bordered tile around a tile reads as a mistake.
   */
  .row__mark--logo {
    border-color: transparent;
    background: none;
  }

  .row__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .row__monogram {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-faint);
  }

  .row__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .row__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .row__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    transition: transform 300ms ease;
  }

  .row__link:hover .row__name {
    transform: translateX(3px);
  }

  .row__tagline {
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 58ch;
  }

  .row__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .row__domain {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--text-faint);
    transition: color 150ms ease;
  }

  .row__link:hover .row__domain {
    color: var(--text);
  }

  .row__arrow {
    width: 1.375rem;
    height: 1.375rem;
    color: var(--neutral-400);
    transition:
      transform 150ms ease,
      color 150ms ease;
  }

  .row__link:hover .row__arrow {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  @media (min-width: 768px) {
    .row__name {
      font-size: 2.25rem;
    }

    .row__link {
      padding-block: 2rem;
    }
  }

  /* The domain moves under the name on narrow screens; the arrow stays put. */
  @media (max-width: 640px) {
    .row__link {
      grid-template-columns: auto 1fr;
      gap: 1rem;
      align-items: start;
    }

    .row__mark {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.625rem;
    }

    .row__name {
      font-size: 1.5rem;
    }

    .row__meta {
      grid-column: 2;
      justify-content: space-between;
      width: 100%;
    }
  }
</style>
