---
import ThemeToggle from './ThemeToggle.astro';

/*
 * Anchors only work on the home page, so on every other route they point back
 * to it — a nav link that silently does nothing is worse than one that navigates.
 */
const onHome = Astro.url.pathname === '/';
// The search page has its own, larger field; a second one in the header is noise.
const onSearch = Astro.url.pathname.startsWith('/search');
const base = onHome ? '' : '/';

// Contribute is a route rather than an anchor, so it is the same link
// everywhere and does not take the `base` prefix.
const links = [
  { label: 'Categories', href: `${base}#categories` },
  { label: 'Built here', href: `${base}#built-here` },
  { label: 'Approach', href: `${base}#approach` },
  { label: 'Contribute', href: '/contribute/' },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="wordmark" href="/">
      devtool<span class="wordmark__tld">.fyi</span>
    </a>

    <nav class="header__nav" aria-label="Sections">
      {links.map((link) => <a class="header__link" href={link.href}>{link.label}</a>)}
    </nav>

    <div class="header__actions">
      {
        !onSearch && (
          <>
            {/* A plain GET form, so it works before and without JavaScript. */}
            <form class="header__search" action="/search/" method="get" role="search">
              <label class="sr-only" for="header-q">
                Search tools
              </label>
              <input
                class="header__search-input"
                id="header-q"
                type="search"
                name="q"
                placeholder="Search tools"
                autocomplete="off"
              />
            </form>
            <a class="header__search-link" href="/search/" aria-label="Search tools">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5" />
              </svg>
            </a>
          </>
        )
      }
      <ThemeToggle />
      <a class="header__cta" href={`${base}#categories`}>Browse</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.125rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .wordmark__tld {
    color: var(--text-faint);
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 2rem;
    margin-right: auto;
    margin-left: 1.5rem;
  }

  .header__link {
    font-size: var(--text-ui);
    font-weight: 500;
    color: var(--text-muted);
    transition: color 150ms ease;
  }

  .header__link:hover {
    color: var(--text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header__cta {
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    padding: 0.625rem 1.25rem;
    font-size: var(--text-ui);
    font-weight: 600;
    line-height: 1;
    transition: background-color 150ms ease;
  }

  .header__cta:hover {
    background: var(--fill-hover);
  }

  .header__search {
    display: none;
  }

  .header__search-input {
    width: 11rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: var(--text-ui);
    line-height: 1.2;
    transition: border-color 150ms ease;
  }

  .header__search-input:hover,
  .header__search-input:focus {
    border-color: var(--border-strong);
  }

  .header__search-input::placeholder {
    color: var(--text-faint);
  }

  /* Below the nav breakpoint the field would crowd the wordmark, so it becomes
     an icon that goes to the search page — styled to sit beside the toggle. */
  .header__search-link {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .header__search-link:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .header__search-link svg {
    width: 1rem;
    height: 1rem;
  }

  /* The CTA is a scroll shortcut, not the only way down — drop it before the
     toggle and wordmark start competing for space. */
  @media (max-width: 420px) {
    .header__cta {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .header__nav {
      display: flex;
    }
  }

  /* Four nav links, a field, the toggle and the CTA only fit together from
     here; between 768px and this the icon stands in for the field. */
  @media (min-width: 1080px) {
    .header__search {
      display: block;
    }

    .header__search-link {
      display: none;
    }
  }
</style>
