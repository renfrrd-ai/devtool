---
/*
 * Cloudflare Web Analytics.
 *
 * Cookieless and per-visit rather than per-person, which is what lets the
 * footer claim nothing personal is stored. It is the only third-party script on
 * the site, and it renders only when a token is present.
 *
 * The token is NOT a secret. It ends up in the HTML of every page, so anyone can
 * read it with view-source; it identifies the site to Cloudflare and grants
 * nothing. That is why it can simply live in src/data/site.ts and be committed.
 *
 * The environment variable is kept as an override for the case where you want
 * production measured but previews left alone. It has to be a *build* variable,
 * not a runtime binding — Astro inlines it during `npm run build`, and a static
 * deployment has no runtime to bind anything to.
 *
 * Leave both empty and no script is emitted at all.
 *
 * Note the beacon counts pageviews and nothing else — Cloudflare Web Analytics
 * has no custom-event API. Outbound clicks are measured with the /go/ redirect
 * pages instead. Setup: docs/analytics.md.
 */
import { SITE } from '../data/site';

const token = import.meta.env.PUBLIC_CF_BEACON_TOKEN || SITE.analyticsToken;
---

{
  token && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token })}
    />
  )
}
