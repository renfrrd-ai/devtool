---
import type { ToolStatus } from '../data/tools';

interface Props {
  status: ToolStatus;
}

const { status } = Astro.props;

const LABELS: Record<ToolStatus, string> = {
  live: 'Live',
  beta: 'Beta',
  'coming-soon': 'Coming Soon',
  idea: 'Idea',
};
---

<span class:list={['badge', `badge--${status}`]}>
  {status === 'live' && <span class="badge__dot" aria-hidden="true"></span>}
  {LABELS[status]}
</span>

<style>
  /*
   * Monochrome by weight, not by hue — every badge carries its text label, so
   * nothing here depends on color to be understood.
   */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    border-radius: 999px;
    padding: 0.1875rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .badge--live {
    background: var(--text);
    color: var(--bg);
  }

  .badge--beta {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .badge--coming-soon {
    background: var(--chip-bg);
    color: var(--text-muted);
  }

  .badge--idea {
    color: var(--text-faint);
    border-color: var(--border-strong);
    border-style: dashed;
  }

  .badge__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: currentColor;
  }
</style>
