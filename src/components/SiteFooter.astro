---
import { SITE } from '../data/site';
import { populatedCategories, sortedMadeHere, categoryHref, toolHref } from '../lib/directory';

const year = new Date().getFullYear();
const cats = populatedCategories();
const mine = sortedMadeHere();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="wordmark" href="/">devtool<span class="wordmark__tld">.fyi</span></a>
      <p class="footer__blurb">
        A curated directory of developer tools, kept deliberately small.
      </p>
    </div>

    <nav class="footer__col footer__col--wide" aria-label="Categories">
      <h2 class="footer__heading">Categories</h2>
      <ul class="footer__list footer__list--split">
        {
          cats.map((category) => (
            <li>
              <a class="footer__link" href={categoryHref(category.id)}>
                {category.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Built here">
      <h2 class="footer__heading">Built here</h2>
      <ul class="footer__list">
        {
          mine.map((tool) => (
            <li>
              <a class="footer__link" href={toolHref(tool.id)}>
                {tool.name}
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="footer__heading footer__heading--spaced">Elsewhere</h2>
      <ul class="footer__list">
        <li>
          <a class="footer__link" href={SITE.author.github} rel="noopener">GitHub</a>
        </li>
        <li>
          <a class="footer__link" href={`mailto:${SITE.author.email}`}>Email</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p class="footer__fine">&copy; {year} {SITE.author.name}</p>
    {/*
      Re-checked when reporting was added, per the standing rule in
      docs/analytics.md that this line gets revisited whenever what the site
      stores changes. A report keeps a reason, an optional sentence and a
      timestamp. It also keeps a salted hash of the reporter's address for a
      day, to stop the same entry being reported fifty times — the address
      itself is never written down and the hash cannot be read back or
      correlated across days. "Nothing personal stored" still holds; "no
      accounts" is now worth saying out loud, because reporting needs none.
    */}
    <p class="footer__fine">
      Static pages. Cookieless analytics, no accounts, nothing personal stored.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 4rem 2.5rem;
  }

  .footer__inner {
    display: grid;
    gap: 2.5rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .wordmark__tld {
    color: var(--text-faint);
  }

  .footer__blurb {
    margin-top: 0.75rem;
    max-width: 28ch;
    font-size: var(--text-ui);
    color: var(--text-muted);
  }

  .footer__heading {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--text-faint);
  }

  .footer__heading--spaced {
    margin-top: 2rem;
  }

  .footer__list {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.875rem;
  }

  .footer__link {
    font-size: var(--text-ui);
    color: var(--text-muted);
    transition: color 150ms ease;
  }

  .footer__link:hover {
    color: var(--text);
  }

  .footer__bottom {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__fine {
    font-size: var(--text-ui);
    color: var(--text-faint);
  }

  @media (min-width: 640px) {
    .footer__inner {
      grid-template-columns: 1.5fr 2fr 1fr;
      gap: 3rem;
    }

    /* Nine categories in one column is a tall stack; two keeps the footer short. */
    .footer__list--split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
