---
// Latin subsets only — the page has no content outside them, and the full
// packages drag in Cyrillic, Greek and Vietnamese faces nothing ever requests.
import '@fontsource/funnel-display/latin-600.css';
import '@fontsource/funnel-display/latin-800.css';
import '@fontsource/funnel-sans/latin-400.css';
import '@fontsource/funnel-sans/latin-500.css';
import '@fontsource/funnel-sans/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';

import { sortedTools } from '../data/tools';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Overrides the site-wide social image. Path under public/. */
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
const squareImage = new URL('/og-square.png', Astro.site).href;

const tools = sortedTools();

/*
 * Three graphs, each doing a distinct job:
 *
 *   WebSite  — names the site itself, so search engines have something to
 *              attach a sitelinks box to.
 *   Person   — the credibility claim the PRD is actually about: one maintainer,
 *              these tools.
 *   ItemList — the directory as ordered data, which is what lets a crawler read
 *              this page as a list of products rather than prose.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': `${SITE.url}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: SITE.author.name,
      url: `${SITE.url}/`,
      sameAs: [SITE.author.github],
      jobTitle: 'Software developer',
      owns: tools.map((tool) => ({
        '@type': 'SoftwareApplication',
        name: tool.name,
        url: tool.url,
        description: tool.tagline,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web',
        author: { '@id': `${SITE.url}/#person` },
      })),
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE.url}/#tools`,
      name: 'Developer tools by Renfred Alonge',
      numberOfItems: tools.length,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        description: tool.tagline,
        url: tool.url,
      })),
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    {/* Paints the browser chrome to match whichever theme is showing. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Open Graph — Facebook, LinkedIn, Slack, Discord, iMessage. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.imageAlt} />

    {/* A square crop for the platforms that take one — WhatsApp, some Telegram clients. */}
    <meta property="og:image" content={squareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={SITE.imageAlt} />

    {/* Twitter/X reads its own namespace and ignores og: when these are present. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={SITE.imageAlt} />
    <meta name="twitter:domain" content={SITE.domain} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {/*
      Applies a stored theme choice before first paint. Inline and blocking on
      purpose — deferring it means a flash of the wrong theme. Absent a stored
      choice we stamp nothing and let prefers-color-scheme decide.
    */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#tools">Skip to the tools</a>
    <slot />
  </body>
</html>
