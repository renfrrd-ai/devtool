# Cloudflare Pages headers.
# Syntax: https://developers.cloudflare.com/pages/configuration/headers/
# This file is served from public/ and applies to the deployed site.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; manifest-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Hashed filenames — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names, occasionally replaced. A day is long enough to help and short
# enough that a rebranded logo shows up without a purge.
/logos/*
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/og-square.png
  Cache-Control: public, max-age=86400

# The page itself must revalidate, or a newly added tool stays invisible.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
